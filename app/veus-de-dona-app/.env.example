# API base URL. For a physical device on the same LAN as your dev machine,
# use your machine's LAN IP (check with `ipconfig`/`ifconfig`) — the app can't
# reach "localhost" since that resolves to the device itself, not your PC.
# For simulators/emulators, "http://localhost:8000" works.
# For a deployed backend, use its public URL.
EXPO_PUBLIC_API_URL=http://192.168.1.134:8000
